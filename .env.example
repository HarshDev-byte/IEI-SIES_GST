# ========================================================
# IEI SIES GST — Council Communication & Mail Service Config
# ========================================================

# The destination email that will receive all membership-related doubts,
# student inquiries, and questions submitted to the Communication Desk.
COUNCIL_RECEIVER_EMAIL="iei@siesgst.ac.in"

# Outgoing Mail Delivery Settings (Optional SMTP / Cloud)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-specific-password"
# SMTP_FROM="\"IEI SIES GST Council Desk\" <your-email@gmail.com>"

# Or Resend API:
# RESEND_API_KEY=""

# ========================================================
# Production Domain Configuration (Vercel / Custom Domain)
# ========================================================
# Used for member static QR code URLs and profile share links.
# If not set, defaults to: https://harshdev-byte.github.io/IEI-SIES_GST
# When you attach your new custom domain in Vercel, set this in Vercel Project Settings -> Environment Variables:
# VITE_SITE_URL="https://yournewdomain.com"
VITE_SITE_URL="https://harshdev-byte.github.io/IEI-SIES_GST"
