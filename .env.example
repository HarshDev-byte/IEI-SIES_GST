# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-specific-password"
# SMTP_FROM="\"IEI SIES GST Council Desk\" <your-email@gmail.com>"

# Or Resend API:
# RESEND_API_KEY=""
